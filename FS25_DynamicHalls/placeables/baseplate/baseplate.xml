<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="dynamicHallsPlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_BASEPLATE_STORE_NAME</name>
        <image>placeables/baseplate/store_baseplate.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sheds</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
    </storeData>

    <base>
        <filename>models/baseplates/baseplate.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart" endNode="testAreaEnd"/>
        </testAreas>
    </placement>

    <dynamicHallsWidth>
        <dynamicHallsWidthConfigurations title="Width">
            <dynamicHallsWidthConfiguration name="10m"  value="10" isDefault="true"/>
            <dynamicHallsWidthConfiguration name="20m"  value="20"/>
            <dynamicHallsWidthConfiguration name="30m"  value="30"/>
            <dynamicHallsWidthConfiguration name="40m"  value="40"/>
            <dynamicHallsWidthConfiguration name="50m"  value="50"/>
            <dynamicHallsWidthConfiguration name="60m"  value="60"/>
            <dynamicHallsWidthConfiguration name="70m"  value="70"/>
            <dynamicHallsWidthConfiguration name="80m"  value="80"/>
            <dynamicHallsWidthConfiguration name="90m"  value="90"/>
            <dynamicHallsWidthConfiguration name="100m" value="100"/>
        </dynamicHallsWidthConfigurations>
    </dynamicHallsWidth>

    <dynamicHallsLength>
        <dynamicHallsLengthConfigurations title="Length">
            <dynamicHallsLengthConfiguration name="10m"  value="10" isDefault="true"/>
            <dynamicHallsLengthConfiguration name="20m"  value="20"/>
            <dynamicHallsLengthConfiguration name="30m"  value="30"/>
            <dynamicHallsLengthConfiguration name="40m"  value="40"/>
            <dynamicHallsLengthConfiguration name="50m"  value="50"/>
            <dynamicHallsLengthConfiguration name="60m"  value="60"/>
            <dynamicHallsLengthConfiguration name="70m"  value="70"/>
            <dynamicHallsLengthConfiguration name="80m"  value="80"/>
            <dynamicHallsLengthConfiguration name="90m"  value="90"/>
            <dynamicHallsLengthConfiguration name="100m" value="100"/>
        </dynamicHallsLengthConfigurations>
    </dynamicHallsLength>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelStart" widthNode="levelWidth" heightNode="levelHeight"/>
        </levelAreas>
    </leveling>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="levelWidth" endNode="levelHeight"/>
    </tipOcclusionUpdateAreas>

    <triggerMarkers>
        <triggerMarker node="interactionTrigger" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="collisionFloor" node="0>0|0" />
        <i3dMapping id="interactionTrigger" node="0>1|0" />
        <i3dMapping id="levelStart" node="0>2|0" />
        <i3dMapping id="levelHeight" node="0>2|0|0" />
        <i3dMapping id="levelWidth" node="0>2|0|1" />
        <i3dMapping id="testAreaStart" node="0>3|0" />
        <i3dMapping id="testAreaEnd" node="0>3|0|0" />
        <i3dMapping id="tileCorner" node="0>4|0" />
        <i3dMapping id="tileCornerInverted" node="0>4|1" />
        <i3dMapping id="tileHorizontal" node="0>4|2" />
        <i3dMapping id="tileVertical" node="0>4|3" />
    </i3dMappings>
</placeable>
