<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="109" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">
    <author>Thodor12</author>
    <version>0.0.1</version>

    <title>
        <en>Dynamic Halls</en>
    </title>

    <description>
        <en>Dynamically buildable hall system. Test box for placement/scripting
            groundwork.</en>
    </description>

    <l10n filenamePrefix="l10n/locale"/>

    <iconFilename>icon_dynamicHalls.dds</iconFilename>

    <multiplayer supported="false"/>

    <storeItems>
        <storeItem xmlFilename="placeables/baseplate/baseplate.xml"/>
    </storeItems>

    <extraSourceFiles>
        <sourceFile filename="scripts/Constants.lua"/>
        <sourceFile filename="scripts/Utils.lua"/>
        <sourceFile filename="scripts/AreaMarkers.lua"/>
        <sourceFile filename="scripts/InteractionTriggerActivatable.lua"/>
        <sourceFile filename="scripts/WarningStripe.lua"/>
        <sourceFile filename="scripts/pieces/PieceDefinition.lua"/>
        <sourceFile filename="scripts/pieces/PieceDefinitionManager.lua"/>
        <sourceFile filename="scripts/pieces/PlacedWallPiece.lua"/>
        <sourceFile filename="scripts/pieces/PlacedTilePiece.lua"/>
        <sourceFile filename="scripts/gui/DynamicHallsOverviewScreen.lua"/>
        <sourceFile filename="scripts/gui/DynamicHallsBuildScreen.lua"/>
        <sourceFile filename="scripts/gui/DynamicHallsGui.lua"/>
    </extraSourceFiles>

    <placeableTypes>
        <type name="dynamicHallsPlaceable" parent="simplePlaceable" className="Placeable" filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="dynamicHallsPlaceable"/>
        </type>
    </placeableTypes>

    <placeableSpecializations>
        <specialization name="dynamicHallsPlaceable" className="DynamicHallsPlaceable" filename="scripts/Placeable.lua"/>
    </placeableSpecializations>
</modDesc>
