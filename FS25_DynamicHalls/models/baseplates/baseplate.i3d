<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="baseplate" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
  </Files>


  <Materials>
    <Material name="i3d_default_material" materialId="1" diffuseColor="0.8 0.8 0.8 1" specularColor="0.501961 1 0">
    </Material>
  </Materials>


  <Shapes externalShapesFile="baseplate.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="baseplateRoot" nodeId="5">
      <TransformGroup name="collision" nodeId="6">
        <Shape name="collisionFloor" shapeId="1" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" nodeId="7" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1"/>
      </TransformGroup>
      <TransformGroup name="interaction" nodeId="8">
        <Shape name="interactionTrigger" shapeId="2" static="true" trigger="true" collisionFilterGroup="0x20000000" collisionFilterMask="0x100000" nodeId="9" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="1"/>
      </TransformGroup>
      <TransformGroup name="leveling" nodeId="10">
        <TransformGroup name="levelStart" nodeId="11">
          <TransformGroup name="levelHeight" nodeId="12"/>
          <TransformGroup name="levelWidth" nodeId="13"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="testAreas" nodeId="14">
        <TransformGroup name="testAreaStart" nodeId="15">
          <TransformGroup name="testAreaEnd" nodeId="16"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="warningStripe" nodeId="17"/>
    </TransformGroup>
  </Scene>

</i3D>
