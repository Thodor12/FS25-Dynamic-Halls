<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="wallStraight1" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/maps/textures/shared/concreteGeneric_diffuse.dds"/>
    <File fileId="2" filename="$data/maps/textures/shared/concreteGeneric_normal.dds"/>
    <File fileId="3" filename="$data/maps/textures/shared/concreteGeneric_specular.dds"/>
  </Files>


  <Materials>
    <Material name="Concrete" materialId="1">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="wallStraight1.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="doors" nodeId="4"/>
    <TransformGroup name="lights" nodeId="5"/>
    <TransformGroup name="lightSwitches" nodeId="6"/>
    <TransformGroup name="mesh" nodeId="7">
      <Shape name="Cube" shapeId="1" nodeId="8" castsShadows="true" receiveShadows="true" materialIds="1"/>
    </TransformGroup>
  </Scene>

</i3D>
