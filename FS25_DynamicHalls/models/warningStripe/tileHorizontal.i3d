<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="tileHorizontal" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/shared/warningStripes_diffuse.dds"/>
    <File fileId="2" filename="$data/shared/warningStripes_normal.dds"/>
    <File fileId="3" filename="$data/shared/warningStripes_specular.dds"/>
  </Files>


  <Materials>
    <Material name="warningStripes_mat" materialId="1">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="tileHorizontal.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="tileHorizontal" shapeId="1" nodeId="4" castsShadows="true" receiveShadows="true" materialIds="1"/>
  </Scene>

</i3D>
